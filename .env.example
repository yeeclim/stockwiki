# ============================================================
# StockWiki 환경변수 예시 — 실제 값으로 채워서 .env 로 복사하거나
# Vercel 대시보드 > Settings > Environment Variables 에 등록하세요.
# 이 파일 자체에는 실제 키를 절대 입력하지 마세요.
# ============================================================

# ── 주식 데이터 API ─────────────────────────────────────────
# Financial Modeling Prep (FMP) — https://financialmodelingprep.com
FMP_API_KEY=

# Finnhub — https://finnhub.io
FINNHUB_API_KEY=

# ── 뉴스 API (서버 전용 — 클라이언트에 노출 금지) ────────────
# NewsData.io — https://newsdata.io
NEWSDATA_API_KEY=

# GNews — https://gnews.io
GNEWS_API_KEY=

# MediaStack — https://mediastack.com
MEDIASTACK_API_KEY=

# ── AI 모델 API ──────────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) — https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── Vercel KV (캐싱) ─────────────────────────────────────────
# Vercel 대시보드에서 KV 스토어 연결 시 자동 주입됨
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Flutter 빌드 시 --dart-define 으로 주입되는 키 ───────────
# FMP, Finnhub 키는 Flutter 웹 빌드 시 아래 방법으로 주입합니다:
#   flutter build web --dart-define=FMP_API_KEY=xxx --dart-define=FINNHUB_API_KEY=xxx
# 주의: 빌드된 JS에 포함되므로, 가능하면 백엔드 프록시 사용을 권장합니다.
