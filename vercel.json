{
  "outputDirectory": "build/web",
  "framework": null,
  "functions": {
    "api/ai-committee-verify.js": { "maxDuration": 60 },
    "api/kr-stock-search.js": { "regions": ["sin1"] }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}