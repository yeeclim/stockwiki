{
  "version": 2,
  "builds": [
    { "src": "build/web/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/ai_recommend_list", "dest": "/api/ai_recommend_list.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/favicon.ico", "dest": "/favicon.png" },
    { "src": "/assets/(.*)", "dest": "/build/web/assets/$1" },
    { "src": "/icons/(.*)", "dest": "/build/web/icons/$1" },
    { "src": "/manifest.json", "dest": "/build/web/manifest.json", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/thumbnail.png", "dest": "/build/web/thumbnail.png" },
    { "src": "/favicon.png", "dest": "/build/web/favicon.png" },
    { "src": "/(.*)", "dest": "/build/web/index.html" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
